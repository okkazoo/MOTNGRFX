   "node_title": "OUT skeleton",
   "kind": "audio",
   "label": "Skeleton (before ACE)"
  },
  {
   "node_title": "OUT restyled raw",
   "kind": "audio",
   "label": "ACE output (unfitted)"
  },
  {
