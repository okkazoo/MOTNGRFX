{
 "story": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": "{}"
  },
  "_meta": {
   "title": "IN story"
  }
 },
 "prompt": {
  "class_type": "MographStoryPrompt",
  "inputs": {
   "story_in": [
    "story",
    0
   ]
  },
  "_meta": {
   "title": "Story prompt"
  }
 },
 "story_llm": {
  "class_type": "MographGGUFVL",
  "inputs": {
   "model": "gemma-4-31b-qat/gemma-4-31B-it-qat-UD-Q4_K_XL.gguf",
   "mmproj": "gemma-4-31b-qat/mmproj-F16.gguf",
   "n_gpu_layers": -1,
   "n_ctx": 12288,
   "max_tokens": 1500,
   "temperature": 0.7,
   "top_p": 0.95,
   "top_k": 64,
   "repeat_penalty": 1.0,
   "seed": 1,
   "kv_cache": "q8_0",
   "flash_attn": true,
   "mmproj_on_gpu": true,
   "n_cpu_moe": 0,
   "handler": "auto",
   "image_max_tokens": -1,
   "strip_thinking": true,
   "keep_model_loaded": true,
   "verbose": false,
   "prompt": [
    "prompt",
    0
   ],
   "system_prompt": "You are a screenwriter for very short music-video pieces (kinetic typography over generated footage). You answer with exactly one JSON object and nothing else. You never reword the user's on-screen lines.",
   "json_mode": true
  },
  "_meta": {
   "title": "Gemma 4 31B QAT Q4_K_XL story (text only)"
  }
 },
 "parse": {
  "class_type": "MographStoryParse",
  "inputs": {
   "reply": [
    "story_llm",
    0
   ],
   "story_in": [
    "story",
    0
   ]
  },
  "_meta": {
   "title": "STORY JSON v1"
  }
 },
 "out_story": {
  "class_type": "PreviewAny",
  "inputs": {
   "source": [
    "parse",
    0
   ]
  },
  "_meta": {
   "title": "OUT story"
  }
 }
}