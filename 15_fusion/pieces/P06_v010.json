 "compose": {
  "size": [
   1080,
   1920
  ],
  "crossfade": [
   0.0833,
   0,
   0.0833,
   0,
   0.0833
  ],
  "crf": 16,
  "default": {
   "ops": [
    {
     "op": "upscale_matte",
     "out": "m",
     "args": {
      "matte": "$matte",
      "size": [
       1080,
       1920
      ],
      "guide": "$footage"
     }
    },
    {
     "op": "grade",
     "out": "foot",
     "args": {
      "frame": "$footage",
      "lift": 0.0,
      "gamma": 1.0,
      "gain": 0.7,
      "sat": 0.9
     }
    },
    {
     "op": "tint_type",
     "out": "tcol",
     "args": {
      "type_a": "$type_line",
      "footage": "$footage",
      "mode": "sample",
      "sample_blur": 60,
      "sat": 0.5,
      "lum_target": 0.93,
      "lum_amount": 0.92
     }
    },
    {
     "op": "fill",
     "out": "warm",
     "args": {
      "like": "$footage",
      "color": [
       1.0,
       0.8,
       0.55
      ]
     }
    },
    {
     "op": "crossfade",
     "out": "tcol",
     "args": {
      "a": "$tcol",
      "b": "$warm",
      "t": {
       "timeline": [
        [
         12.375,
         0.0
        ],
        [
         15.5,
         0.8
        ],
        [
         18.0,
         0.8
        ]
       ]
      }
     }
    },
    {
     "op": "crossfade",
     "out": "ta",
     "args": {
      "a": "$type_line",
      "b": "$type_matte",
      "t": {
       "timeline": [
        [
         11.75,
         0.0
        ],
        [
         12.75,
         1.0
        ]
       ]
      }
     }
    },
    {
     "op": "legible",
     "out": "m",
     "args": {
      "type_a": "$ta",
      "matte": "$m",
      "t": "$t",
      "fps": 24,
      "min_vis": 0.8,
      "min_frac": 0.8,
      "ramp_s": 0.25,
      "matte_threshold": 0.5,
      "matte_soft": 0.08
     }
    },
    {
     "op": "sandwich",
     "out": "image",
     "args": {
      "footage": "$foot",
      "type_rgb": "$tcol",
      "type_a": "$ta",
      "matte": "$m",
      "type_opacity": 1.0,
      "matte_threshold": 0.5,
      "matte_soft": 0.08
     }
    },
    {
     "op": "add_glow",
     "out": "image",
     "args": {
      "img": "$image",
      "mask": "$type_matte",
      "radius": 24,
      "intensity": {
       "curve": "sub",
       "lo": 0.03,
       "hi": 0.15
      },
      "color": [
       1.0,
       1.0,
       0.0
      ]
     }
    },
    {
     "op": "grade",
     "out": "image",
     "args": {
      "frame": "$image",
      "lift": 0.012,
      "gamma": 1.0,
      "gain": 1.0,
      "sat": 1.0
     }
    },
    {
     "op": "grain",
     "out": "image",
     "args": {
      "frame": "$image",
      "frame_idx": "$frame_idx",
      "seed": 1,
      "amount": 0.02,
      "size": 1.3
     }
    },
    {
     "op": "vignette",
     "out": "image",
     "args": {
      "frame": "$image",
      "strength": 0.2
     }
    }
   ]
  },
