       1.0,
       0.8,
       0.55
      ]
     }
    },
    {
     "op": "crossfade",
     "out": "tcol",
     "args": {
      "a": "$tcol",
      "b": "$warm",
      "t": {
       "timeline": [
        [
         12.375,
         0.0
        ],
        [
         15.5,
         0.8
        ],
        [
         18.0,
         0.8
        ]
       ]
      }
     }
    },
    {
     "op": "crossfade",
     "out": "ta",
     "args": {
      "a": "$type_line",
      "b": "$type_matte",
      "t": {
       "timeline": [
        [
         11.75,
         0.0
        ],
        [
         12.75,
         1.0
        ]
       ]
      }
     }
    },
    {
     "op": "legible",
     "out": "m",
     "args": {
      "type_a": "$ta",
      "matte": "$m",
      "t": "$t",
      "fps": 24,
      "min_vis": 0.8,
      "min_frac": 0.8,
      "ramp_s": 0.25,
      "matte_threshold": 0.5,
      "matte_soft": 0.08
     }
    },
    {
     "op": "sandwich",
     "out": "image",
     "args": {
      "footage": "$foot",
      "type_rgb": "$tcol",
      "type_a": "$ta",
      "matte": "$m",
      "type_opacity": 1.0,
      "matte_threshold": 0.5,
      "matte_soft": 0.08
     }
    },
    {
     "op": "add_glow",
     "out": "image",
     "args": {
      "img": "$image",
      "mask": "$type_matte",
      "radius": 24,
      "intensity": {
       "curve": "sub",
       "lo": 0.1,
       "hi": 0.3
      },
      "color": [
       0.8,
       0.2,
       0.2
      ]
     }
    },
    {
     "op": "grade",
     "out": "image",
     "args": {
      "frame": "$image",
      "lift": 0.012,
      "gamma": 1.0,
      "gain": 1.0,
      "sat": 1.0
     }
    },
    {
     "op": "grain",
