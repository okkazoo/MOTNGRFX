{
 "technique": "behind",
 "from": "15_fusion/pieces/P01.json (salt-silver)",
 "ref_cut": 14.4,
 "doc": "Letters behind a SOLID subject (people, animals, objects): depth control with a low guide (0.4), Alpha-Gen matte of the footage, sandwich(type between background and subject) with a thresholded matte (matte_threshold 0.5, matte_soft 0.08) so the subject fully hides the letters; use `behind_sheer` for mist / glass / silk. The scene prompt needs one clear subject (Alpha-Gen returns an empty matte otherwise). Timeline keys rescaled to the cut. (2026-10-30: no default add_glow behind the type; glow only as the hold-life effect glow_breathe or a designed module.)",
 "control_pass": "depth",
 "guide": 0.4,
 "type_passes": [
  "matte",
  "depth",
  "line"
 ],
 "shot": {
  "depth": false,
  "matte": true
 },
 "subject_required": true,
 "compose": {
  "default": {
   "ops": [
    {
     "op": "upscale_matte",
     "out": "m",
     "args": {
      "matte": "$matte",
      "size": [
       1080,
       1920
      ],
      "guide": "$footage"
     }
    },
    {
     "op": "grade",
     "out": "foot",
     "args": {
      "frame": "$footage",
      "lift": 0.0,
      "gamma": 1.0,
      "gain": 0.66,
      "sat": 0.7
     }
    },
    {
     "op": "tint_type",
     "out": "tcol",
     "args": {
      "type_a": "$type_line",
      "footage": "$footage",
      "mode": "sample",
      "sample_blur": 60,
      "sat": 0.5,
      "lum_target": 0.93,
      "lum_amount": 0.92
     }
    },
    {
     "op": "fill",
     "out": "warm",
     "args": {
      "like": "$footage",
      "color": [
       1.0,
       0.8,
       0.55
      ]
     }
    },
    {
     "op": "crossfade",
     "out": "tcol",
     "args": {
      "a": "$tcol",
      "b": "$warm",
      "t": {
       "timeline": [
        [
         9.9,
         0.0
        ],
        [
         12.4,
         0.8
        ],
        [
         14.4,
         0.8
        ]
       ]
      }
     }
    },
    {
     "op": "crossfade",
     "out": "ta",
     "args": {
      "a": "$type_line",
      "b": "$type_matte",
      "t": {
       "timeline": [
        [
         9.4,
         0.0
        ],
        [
         10.2,
         1.0
        ]
       ]
      }
     }
    },
    {
     "op": "legible",
     "out": "m",
     "args": {
      "type_a": "$ta",
      "matte": "$m",
      "t": "$t",
      "fps": 24,
      "min_vis": 0.8,
      "min_frac": 0.8,
      "ramp_s": 0.25,
      "matte_threshold": 0.5,
      "matte_soft": 0.08
     }
    },
    {
     "op": "sandwich",
     "out": "image",
     "args": {
      "footage": "$foot",
      "type_rgb": "$tcol",
      "type_a": "$ta",
      "matte": "$m",
      "type_opacity": {
       "timeline": [
        [
         0,
         0.0
        ],
        [
         1.0,
         0.15
        ],
        [
         3.8,
         0.8
        ],
        [
         7.1,
         0.88
        ],
        [
         10.4,
         0.95
        ],
        [
         14.4,
         0.95
        ]
       ]
      },
      "matte_threshold": 0.5,
      "matte_soft": 0.08
     }
    },
    {
     "op": "grade",
     "out": "image",
     "args": {
      "frame": "$image",
      "lift": 0.012,
      "gamma": 1.0,
      "gain": 1.0,
      "sat": 1.0
     }
    },
    {
     "op": "grain",
     "out": "image",
     "args": {
      "frame": "$image",
      "frame_idx": "$frame_idx",
      "seed": 1,
      "amount": 0.025,
      "size": 1.3
     }
    },
    {
     "op": "vignette",
     "out": "image",
     "args": {
      "frame": "$image",
      "strength": 0.3
     }
    }
   ]
  },
  "shots": {}
 }
}
